#!/usr/bin/env bash

DOI_BASEURL={{ dataverse.doi.baseurl }}
DOI_USERNAME={{ dataverse.doi.username }}
DOI_PASSWORD={{ dataverse.doi.password }}
DEF_BASEURL="https\://mds.test.datacite.org"

# doi.baseurlstring   -->  dataverse.pid.datacite.mds-api-url
# doi.username        -->  dataverse.pid.datacite.username
# doi.password        -->  dataverse.pid.datacite.password

ASADMIN={{ payara_dir }}/bin/asadmin

#if [ ! -z "$DOI_BASEURL" ] && [[ ! $DOI_BASEURL == *mds.test.datacite.org* ]]; then
#        $ASADMIN delete-jvm-options "\"-Ddataverse.pid.datacite.mds-api-url=$DEF_BASEURL""
#fi

if [ ! -z "$DOI_BASEURL" ]; then
        $ASADMIN delete-jvm-options "\"-Ddataverse.pid.datacite.mds-api-url=$DEF_BASEURL""
        DOI_BASEURL_ESC=`echo $DOI_BASEURL | sed -e 's/:/\\:/'`
        $ASADMIN create-jvm-options "-Ddataverse.pid.datacite.mds-api-url=$DOI_BASEURL_ESC\""
fi
if [ ! -z "$DOI_USERNAME" ]; then
        $ASADMIN create-jvm-options "-Ddataverse.pid.datacite.username=$DOI_USERNAME"
fi
if [ ! -z "$DOI_PASSWORD" ]; then
        $ASADMIN create-jvm-options "-Ddataverse.pid.datacite.password=$DOI_PASSWORD"
fi
